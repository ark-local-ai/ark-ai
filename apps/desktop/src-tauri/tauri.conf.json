{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "方舟",
  "version": "0.1.0",
  "identifier": "com.ark.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ark · 方舟",
        "width": 1280,
        "height": 800,
        "minWidth": 975,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
