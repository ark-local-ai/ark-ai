{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities for the Ark desktop shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    {
      "identifier": "core:window:allow-close",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-minimize",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-toggle-maximize",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-maximize",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-unmaximize",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-is-maximized",
      "windows": ["main"]
    },
    {
      "identifier": "core:window:allow-start-dragging",
      "windows": ["main"]
    }
  ]
}
